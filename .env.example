# ---------------------------------------------------------------
# Copiar como .env y ajustar valores. NUNCA commitear el .env real.
# ---------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gymdb

# --- Backend ---
# Dentro de Docker el host es "db"; para correr en local con venv usar "localhost".
DATABASE_URL=postgresql+psycopg://gym:changeme@db:5432/gymdb

# --- Seguridad / JWT ---
JWT_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes autorizados a llamar al API desde un navegador, separados por coma.
# Vacio en el despliegue normal: Nginx sirve el frontend y el API por el mismo
# origen. Solo hace falta si se abre el frontend por fuera del proxy, por
# ejemplo con Live Server:  CORS_ORIGINS=http://localhost:5500
CORS_ORIGINS=

# --- Notifier ---
NOTIFIER_INTERVAL_MINUTES=60
# Zona horaria del gimnasio, para reportar las horas pico en hora local.
# Nombre de la base IANA, p. ej. America/Mexico_City o Europe/Madrid.
GYM_TIMEZONE=UTC

NOTIFIER_DAYS_BEFORE_EXPIRATION=7

# --- Puertos expuestos en el host ---
# DB_PORT solo publica la base hacia esta maquina (DBeaver, psql). Los
# contenedores hablan con ella por la red interna (db:5432) y no lo usan,
# asi que se puede cambiar si el puerto ya esta ocupado en el host.
DB_PORT=5432
API_PORT=8000
PROXY_PORT=80
