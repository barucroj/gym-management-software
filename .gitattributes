# Normaliza finales de linea: LF en el repositorio siempre.
# Evita conflictos entre el equipo en Windows y el equipo en Linux.
* text=auto eol=lf

# Archivos que DEBEN ser LF (se ejecutan dentro de contenedores Linux)
*.py        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
.env.example text eol=lf

# Archivos propios de Windows
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binarios: sin conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.zip       binary
